{
  "name": "ilokesto",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "docs:prepare": "pnpm --filter '@ilokesto/docs^...' build",
    "docs:dev": "pnpm docs:prepare && pnpm --filter @ilokesto/docs dev",
    "docs:build": "pnpm --filter @ilokesto/docs... build",
    "docs:start": "pnpm --filter @ilokesto/docs start",
    "docs:typecheck": "pnpm docs:prepare && pnpm --filter @ilokesto/docs typecheck",
    "docs:test": "pnpm --filter @ilokesto/docs test",
    "docs:build:store-pilot": "NEXT_PUBLIC_STORE_DOCS_PILOT=1 pnpm docs:build",
    "docs:dev:store-pilot": "NEXT_PUBLIC_STORE_DOCS_PILOT=1 pnpm docs:dev",
    "docs:typecheck:store-pilot": "NEXT_PUBLIC_STORE_DOCS_PILOT=1 pnpm docs:typecheck",
    "docs:test:store-pilot": "NEXT_PUBLIC_STORE_DOCS_PILOT=1 pnpm docs:test",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --filter '!@ilokesto/state' --if-present run test && pnpm --filter @ilokesto/state test",
    "test:monorepo": "node --test tests/monorepo/*.test.mjs",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version && pnpm install --lockfile-only",
    "release": "node scripts/publish-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.0"
  }
}
